{
  "name": "@rivid/prisma",
  "version": "1.1.0",
  "description": "Prisma client extension — automatic ULID/UUIDv7 primary keys powered by the rivid engine",
  "author": {
    "name": "Vedant Chalke"
  },
  "license": "MIT",
  "homepage": "https://github.com/vedantchalke36/rivid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedantchalke36/rivid.git"
  },
  "bugs": {
    "url": "https://github.com/vedantchalke36/rivid/issues"
  },
  "keywords": [
    "prisma",
    "prisma-client",
    "ulid",
    "uuidv7",
    "primary-key",
    "sortable",
    "extension"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@rivid/core": "^0.1.0"
  },
  "devDependencies": {
    "@rivid/core": "file:../..",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node ../../scripts/build-ts-package.mjs",
    "test": "node --import tsx --test test/*.test.mts"
  }
}
